# Omni-Rewriter reads process environment variables; it does not load this file automatically.
# Copy to .env for local use, keep real secrets out of version control, then source it.

# OpenAI-compatible Writer (must match the SGLang/vLLM served model name).
# Recommended: bash scripts/serve/serve_sglang_qwen_writer.sh  →  :8000
# Language + vision: https://huggingface.co/Qwen/Qwen3.6-35B-A3B
OMNI_WRITER_BACKEND_BASE_URL=http://127.0.0.1:8000/v1
OMNI_WRITER_BACKEND_MODEL=Qwen/Qwen3.6-35B-A3B
# OMNI_WRITER_BACKEND_API_KEY=
OMNI_WRITER_TIMEOUT=120
OMNI_WRITER_RETRIES=2
OMNI_WRITER_TEMPERATURE=0.2
# OMNI_WRITER_MAX_TOKENS=
OMNI_WRITER_ENABLE_THINKING=false
OMNI_WRITER_MAX_REPAIRS=2
# CLI defaults to allowing local media paths. HTTP create_app denies them unless this is true.
# OMNI_WRITER_ALLOW_LOCAL_MEDIA=false

# Optional local MiniMax-H3 (SGLang diffusion). Recommended:
#   OMNI_WRITER_H3_MODEL=/path/to/MiniMax-H3/FL2VA bash scripts/serve/serve_sglang_h3.sh
OMNI_WRITER_H3_BASE_URL=http://127.0.0.1:30010
# OMNI_WRITER_H3_API_KEY=
OMNI_WRITER_H3_TIMEOUT=60
OMNI_WRITER_H3_POLL_INTERVAL=2
OMNI_WRITER_H3_POLL_TIMEOUT=900
OMNI_WRITER_H3_MAX_DOWNLOAD_BYTES=2147483648
# OMNI_WRITER_H3_MODEL=/path/to/MiniMax-H3/FL2VA
# OMNI_WRITER_H3_NUM_GPUS=8
# OMNI_WRITER_H3_PORT=30010

# Optional OpenAI-compatible image generation (for example SGLang Qwen-Image).
OMNI_WRITER_IMAGE_BASE_URL=http://127.0.0.1:30010/v1
# OMNI_WRITER_IMAGE_API_KEY=
OMNI_WRITER_IMAGE_MODEL=Qwen/Qwen-Image-2512
OMNI_WRITER_IMAGE_TIMEOUT=300
OMNI_WRITER_IMAGE_MAX_DOWNLOAD_BYTES=67108864
OMNI_WRITER_IMAGE_RESPONSE_FORMAT=b64_json

# Optional vLLM-Omni / SGLang Omni video generation.
OMNI_WRITER_VIDEO_BASE_URL=http://127.0.0.1:8091/v1
# OMNI_WRITER_VIDEO_API_KEY=
OMNI_WRITER_VIDEO_TIMEOUT=60
OMNI_WRITER_VIDEO_POLL_INTERVAL=2
OMNI_WRITER_VIDEO_POLL_TIMEOUT=900
OMNI_WRITER_VIDEO_MAX_DOWNLOAD_BYTES=2147483648
OMNI_WRITER_VIDEO_MAX_REFERENCE_BYTES=33554432
OMNI_WRITER_VIDEO_TRANSPORT=multipart
OMNI_WRITER_WAN_MODEL=Wan-AI/Wan2.2-T2V-A14B
OMNI_WRITER_WAN_DEFAULT_SIZE=832x480

# Optional HunyuanImage-3.0 vLLM chat extension.
OMNI_WRITER_HUNYUAN_IMAGE_BASE_URL=http://127.0.0.1:8000/v1
# OMNI_WRITER_HUNYUAN_IMAGE_API_KEY=
OMNI_WRITER_HUNYUAN_IMAGE_MODEL=vllm_hunyuan_image3
OMNI_WRITER_HUNYUAN_IMAGE_TIMEOUT=600
OMNI_WRITER_HUNYUAN_IMAGE_MAX_BYTES=67108864

# Optional MiniMax API. Supply the key through your shell or secret manager.
# MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_TIMEOUT=60
MINIMAX_POLL_INTERVAL=2
MINIMAX_POLL_TIMEOUT=900

# Writer serve overrides for serve_sglang_qwen_writer.sh (recommended) and
# serve_qwen35_*.sh (vLLM Qwen3.5 alternate). HF id or a local snapshot both work.
# OMNI_WRITER_MODEL=Qwen/Qwen3.6-35B-A3B
# OMNI_WRITER_SERVED_MODEL_NAME=Qwen/Qwen3.6-35B-A3B
# OMNI_WRITER_SGLANG_HOST=127.0.0.1
# OMNI_WRITER_SGLANG_PORT=8000
# OMNI_WRITER_VLLM_HOST=127.0.0.1
# OMNI_WRITER_VLLM_PORT=8000
# OMNI_WRITER_MAX_MODEL_LEN=32768
# OMNI_WRITER_TENSOR_PARALLEL_SIZE=4
# OMNI_WRITER_SGLANG_MEM_FRACTION=0.80
# OMNI_WRITER_REASONING_PARSER=qwen3
# OMNI_WRITER_GPU_MEMORY_UTILIZATION=0.90
# Reconstruct observe with this Writer may need a longer chat timeout:
# OMNI_WRITER_TIMEOUT=300

# Optional LTX-2.5 official distilled CLI (expand ≠ generate; live runtime unverified).
# OMNI_LTX_CHECKPOINT=/path/to/models/ltx-2.5
# OMNI_LTX_UPSTREAM=/path/to/LTX-2
